{
  "name": "@cyanheads/nhtsa-vehicle-safety-mcp-server",
  "version": "0.8.0",
  "description": "Decode VINs, search recalls, complaints, crash ratings, and investigations via MCP. STDIO or Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nhtsa-vehicle-safety-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "Dockerfile",
    "server.json",
    "manifest.json"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run build",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "tree": "bun run scripts/tree.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "test": "bunx vitest run",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio bun ./dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http bun ./dist/index.js",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "list-skills": "bun run scripts/list-skills.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/nhtsa-vehicle-safety-mcp-server.mcpb",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nhtsa",
    "vehicle-safety",
    "recalls",
    "vin-decoder",
    "crash-ratings",
    "ncap",
    "typescript"
  ],
  "author": "cyanheads <casey@caseyjhand.com> (https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server#readme)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "homepage": "https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server/issues"
  },
  "mcpName": "io.github.cyanheads/nhtsa-vehicle-safety-mcp-server",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.11",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.9.16",
    "fflate": "^0.8.3",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^25.9.1",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.5",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
