{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nhtsa-vehicle-safety-mcp-server",
  "version": "0.11.0",
  "description": "Decode VINs, search recalls, complaints, crash ratings, and investigations via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server#readme",
  "repository": "https://github.com/cyanheads/nhtsa-vehicle-safety-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "nhtsa", "vehicle-safety", "recalls", "vin-decoder", "crash-ratings", "ncap", "stdio", "streamable-http", "typescript"],
  "userConfig": {
    "NHTSA_CLAMP_LIMITS": {
      "type": "string",
      "title": "Clamp over-cap requests",
      "description": "Clamp an over-cap page size (limit) or VIN batch to its cap and disclose it with a notice. Set false to reject it instead.",
      "default": "true"
    }
  },
  "mcpServers": {
    "nhtsa-vehicle-safety-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/nhtsa-vehicle-safety-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "NHTSA_CLAMP_LIMITS": "${user_config.NHTSA_CLAMP_LIMITS}"
      }
    }
  }
}
